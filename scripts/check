#!/usr/bin/env python3
"""Check the static pages and Doxygen-generated C++ reference."""
from html.parser import HTMLParser
from pathlib import Path
import re
import subprocess
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parent.parent
PUBLIC = ROOT / "public"


class Page(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = []
        self.links = []
        self.h1 = 0
        self.scripts = 0
        self.in_code = False
        self.code = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if "id" in attrs:
            self.ids.append(attrs["id"])
        self.h1 += tag == "h1"
        self.scripts += tag == "script"
        if tag == "code":
            self.in_code = True
        if "href" in attrs:
            self.links.append(attrs["href"])

    def handle_endtag(self, tag):
        if tag == "code":
            self.in_code = False

    def handle_data(self, data):
        if self.in_code:
            self.code.append(data)


for relative in ["index.html", "cpp/index.html"]:
    text = (PUBLIC / relative).read_text()
    assert "@@" not in text, relative
    page = Page()
    page.feed(text)
    assert page.h1 == 1 and page.scripts == 0, relative
    assert len(page.ids) == len(set(page.ids)), relative
    assert "main" in page.ids and "intro-heading" in page.ids, relative
    for link in page.links:
        parts = urlsplit(link)
        if parts.scheme:
            assert parts.scheme == "https" and parts.netloc, link
        elif parts.path:
            target = PUBLIC / parts.path.lstrip("/")
            if parts.path.endswith("/"):
                target /= "index.html"
            assert target.is_file(), link
        elif parts.fragment:
            assert parts.fragment in page.ids, link
    if relative.startswith("cpp/"):
        revision = re.search(r"/blob/([0-9a-f]{40})/", text).group(1)
        source = subprocess.check_output([
            "git", "-C", str(ROOT.parent / "verbs"), "show",
            revision + ":packages/cpp/include/verbs/verbs.hpp"
        ]).decode()
        assert (PUBLIC / "cpp/verbs.hpp").read_text() == source, "header download must be verbatim"
        api = "".join(page.code)
        for declaration in [
            "template <typename T, typename Predicate>",
            "T verbs::check(std::string name, T value, Predicate &&predicate);",
            "class verbs::violation : public std::runtime_error",
            "const std::string verbs::violation::constraint;",
            "explicit verbs::violation::violation(std::string name);",
        ]:
            assert declaration in api, declaration
        assert text.count('class="api-member"') == 3, "seed API surface changed; inspect generated docs"
        assert "Bounded" not in api, "do not expose design sketches as current API"
        subprocess.run([str(ROOT / "scripts/render-cpp"), "--check",
                        "--revision", revision], check=True)

css = (PUBLIC / "styles.css").read_text()
for asset in re.findall(r'url\("(/[^\"]+)"\)', css):
    assert (PUBLIC / asset.lstrip("/")).is_file(), asset
assert not re.search(r"(?:animation|transition)\s*:", css)
print("Pages, local links, assets, unique IDs, no scripts/motion, and Doxygen seed API/source fidelity OK.")
