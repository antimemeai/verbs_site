#!/usr/bin/env python3
"""Render a verbatim C++ seed source reference, not a C++ API parser."""
import argparse
import html
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
HEADER = "packages/cpp/include/verbs/verbs.hpp"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=ROOT.parent / "verbs")
    parser.add_argument("--revision", default="origin/main")
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()

    def git(*arguments):
        return subprocess.check_output(["git", "-C", str(args.repo), *arguments])

    revision = git("rev-parse", "--verify", "--end-of-options",
                   args.revision + "^{commit}").decode().strip()
    if not re.fullmatch(r"[0-9a-f]{40}", revision):
        raise SystemExit("expected a full SHA-1 source commit")
    source = git("show", revision + ":" + HEADER).decode("utf-8")
    license_text = git("show", revision + ":LICENSE")
    template = (ROOT / "templates/cpp.html").read_text()
    # Insert source last: source text must never be interpreted as template data.
    rendered = (template.replace("@@REVISION@@", revision)
                .replace("@@SHORT_REVISION@@", revision[:12])
                .replace("@@SOURCE@@", html.escape(source)))
    outputs = {
        ROOT / "public/cpp/index.html": rendered.encode(),
        ROOT / "public/cpp/LICENSE.txt": license_text,
    }
    if args.check:
        bad = [str(p.relative_to(ROOT)) for p, data in outputs.items()
               if not p.is_file() or p.read_bytes() != data]
        if bad:
            raise SystemExit("stale C++ snapshot: " + ", ".join(bad))
        print("C++ source and license match", revision)
    else:
        for path, data in outputs.items():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
        print("Rendered C++ source and license from", revision)
    return 0


if __name__ == "__main__":
    sys.exit(main())
